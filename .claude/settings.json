{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",

    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "Skill",
      "TodoWrite",

      "Bash",
      "PowerShell"
    ],

    "ask": [
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -f *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(truncate *)",
      "Bash(shred *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(rmdir *)",
      "PowerShell(del *)",
      "PowerShell(Clear-Content *)",
      "PowerShell(Format-Volume*)",
      "PowerShell(Clear-Disk*)",
      "PowerShell(Set-ItemProperty HKLM:*)",
      "PowerShell(Remove-ItemProperty HKLM:*)",
      "Bash(reg delete*)",
      "PowerShell(reg delete*)",
      "Bash(diskpart*)",
      "PowerShell(diskpart*)"
    ],

    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(type .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(cat .env*)",

      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git clean*)",
      "Bash(git filter-branch*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)",
      "PowerShell(git reset*)",
      "PowerShell(git checkout*)",
      "PowerShell(git restore*)",
      "PowerShell(git stash*)",
      "PowerShell(git rebase*)",
      "PowerShell(git merge*)",
      "PowerShell(git clean*)",
      "PowerShell(git filter-branch*)",

      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -f /*)",

      "Bash(vercel rm *)",
      "Bash(vercel remove *)",
      "Bash(vercel env rm *)",
      "Bash(vercel env add *)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "PowerShell(vercel rm *)",
      "PowerShell(vercel env rm *)",
      "PowerShell(vercel --prod*)",

      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh secret *)",
      "PowerShell(npm publish*)",
      "PowerShell(pnpm publish*)"
    ]
  }
}
