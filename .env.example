# VOSK.DEV environment variables.
# Copy to `.env.local` for local dev; set the same keys in Vercel for prod/preview.
# The site builds and runs with NONE of these set — the contact form then shows a
# friendly "email me directly" fallback instead of sending.

# Canonical public site URL. Client-safe (NEXT_PUBLIC_). Used for metadata,
# canonicals, sitemap, and OG image absolute URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://vosk.dev"

# --- Contact form (server-only; never exposed to the client) ---

# Resend API key. Create at https://resend.com → API Keys. Without it the form no-ops.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Inbox that receives contact messages. Plain email address.
# Optional — defaults to vosk.dev@gmail.com (siteConfig.contactEmail).
CONTACT_TO_EMAIL="vosk.dev@gmail.com"

# Verified sender address. Accepts "Name <email>" or a bare address.
# Optional — defaults to "VOSK Website <onboarding@resend.dev>" (Resend's shared
# test sender, works immediately). Switch to noreply@vosk.dev once the domain is
# verified in Resend (see docs/contact-setup.md).
CONTACT_FROM_EMAIL="VOSK Website <noreply@vosk.dev>"
