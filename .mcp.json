{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=howpxpdnjjzdwqrgxkee&features=database,development,functions,debugging,docs"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com/yaga/vosk-dev"
    },
    "n8n": {
      "type": "http",
      "url": "https://n8n.vosk.dev/mcp-server/http",
      "headers": {
        "Authorization": "Bearer ${N8N_MCP_TOKEN}"
      }
    },
    "fallow": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "-p", "fallow", "fallow-mcp"],
      "env": {
        "FALLOW_TIMEOUT_SECS": "300"
      }
    },
    "ga": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "analytics-mcp==1.1.0", "google-analytics-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GA_SA_KEY_FILE}",
        "GOOGLE_CLOUD_PROJECT": "${GA_GCP_PROJECT}"
      }
    },
    "gtm": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/mcp-gtm.mjs"]
    }
  }
}


