{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=howpxpdnjjzdwqrgxkee&features=database,development,functions,debugging,docs"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com/yaga/vosk-dev"
    },
    "n8n": {
      "type": "http",
      "url": "https://pwx.imv.mybluehost.me/mcp-server/http",
      "headers": {
        "Authorization": "Bearer ${N8N_MCP_TOKEN}"
      }
    },
    "fallow": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "-p", "fallow", "fallow-mcp"],
      "env": {
        "FALLOW_TIMEOUT_SECS": "300"
      }
    }
  }
}


