# Copy to `.env` on the VPS, next to docker-compose.yml. Never commit the filled version.
#
# Generate each secret with:  openssl rand -base64 42

# Hostname the instance answers on. Must have an A/AAAA record pointing at the VPS before
# `docker compose up`, or Caddy cannot obtain a certificate.
SUPERSET_HOSTNAME=bi.vosk.dev

# Superset's own signing key. Rotating it invalidates all sessions AND makes every stored
# database-connection password undecryptable. Set once, back it up.
SUPERSET_SECRET_KEY=

# Signs guest tokens. Independent of the above. Every process serving the API must agree
# on this value.
SUPERSET_GUEST_TOKEN_JWT_SECRET=

# Metadata Postgres password.
POSTGRES_PASSWORD=

# Space-separated exact origins allowed to frame the dashboards, protocol included.
# No wildcards. This becomes CSP frame-ancestors and the CORS origin list.
SUPERSET_FRAME_ANCESTORS=https://vosk.dev http://localhost:3000
